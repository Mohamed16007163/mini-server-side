{
  "openapi": "3.0.0",
  "info": {
    "title": "Auth Login & Protect API",
    "version": "1.0.0",
    "description": "A secure API using Supabase Auth for signup, login, logout, and protected routes."
  },
  "servers": [
    { "url": "http://localhost:4000" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "Create a new user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created" },
          "400": { "description": "Missing or invalid fields" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user and return JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful, returns access token" },
          "400": { "description": "Missing fields" },
          "401": { "description": "Invalid login credentials" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Terminate the user session",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Logged out successfully" },
          "401": { "description": "Missing or invalid token" }
        }
      }
    },
    "/public/info": {
      "get": {
        "summary": "Read public, unprotected data",
        "responses": {
          "200": { "description": "Public info" }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "summary": "Read private user profile data",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile data" },
          "401": { "description": "Missing or invalid token" }
        }
      }
    },
    "/protected/dashboard": {
      "get": {
        "summary": "Read private dashboard data",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Dashboard welcome message" },
          "401": { "description": "Missing or invalid token" }
        }
      }
    },
    "/api/tickets/triage": {
      "post": {
        "summary": "Classify a support ticket message using an LLM (category, priority, confidence)",
        "description": "Sends the ticket text to an LLM and validates its response against a strict schema before returning it. Retries transient failures (timeouts, 5xx, malformed model output) up to 2 times; does not retry unrecoverable errors like invalid credentials.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 5000,
                    "description": "Raw customer ticket text to classify"
                  }
                },
                "required": ["message"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket classified successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "category": {
                          "type": "string",
                          "enum": ["billing", "technical", "account", "feature_request", "other"]
                        },
                        "priority": {
                          "type": "string",
                          "enum": ["low", "medium", "high", "urgent"]
                        },
                        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                        "reason": { "type": "string", "maxLength": 200 }
                      }
                    },
                    "attempts": { "type": "integer", "description": "Number of model calls actually made (1-3)" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid input — message missing or outside the 3-5000 character range" },
          "502": {
            "description": "The model failed to produce a valid classification after retries, or the upstream provider returned an unrecoverable error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean", "example": false },
                    "error": { "type": "string" },
                    "retryable": { "type": "boolean" },
                    "attempts": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}